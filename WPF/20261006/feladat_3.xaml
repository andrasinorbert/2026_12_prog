<Window x:Class="_20261006.feladat_3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20261006"
        mc:Ignorable="d"
        Title="Bejelentkezés" Height="450" Width="800">
    <StackPanel
        Width="350"
        VerticalAlignment="Center"
        HorizontalAlignment="Center">
        <TextBlock  Text="Bejelentkezés"
                    FontSize="28"
                    FontWeight="Bold"
                    Margin="10"
                    HorizontalAlignment="Center"/>
        <TextBlock Text="Felhasználónév" Margin="10"/>
        <TextBox    Name="usernameTextBox"
                    Margin="10"
                    MinHeight="35"/>
        <TextBlock Text="Jelszó" Margin="10"/>
        <PasswordBox    Name="passwordBox"
                        Margin="10"
                        MinHeight="35"/>
        <Button Content="Belépés" Margin="10"/>
    </StackPanel>
</Window>
